# =============================================================================
# Telegram Sheets Bot — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Telegram -----------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# The channel or group the PDFs are posted to. This also works with a
# regular group/supergroup ID, not just a channel — the bot just needs
# permission to send messages/documents there.
# Numeric IDs for channels/supergroups are negative and typically start with -100.
TELEGRAM_CHANNEL_ID=-1001234567890

# The only Telegram user ID allowed to use /status and the manual report button.
ADMIN_TELEGRAM_ID=123456789


# --- Google Sheets --------------------------------------------------------
# Full URL of the private spreadsheet. The spreadsheet ID is extracted
# from this URL automatically — no separate SPREADSHEET_ID variable needed.
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit

# Absolute path to the Service Account JSON key file. Keep this OUTSIDE
# the git repository, e.g. under ~/.config/telegram-sheets-bot/.
GOOGLE_SERVICE_ACCOUNT_FILE=/home/USERNAME/.config/telegram-sheets-bot/service-account.json


# --- Worksheet identifiers -------------------------------------------------
# Google Sheets "sheetId" (a.k.a. gid) of each worksheet tab — NOT its
# name or tab position. Find it by opening the tab in a browser and
# reading the `gid=` value from the URL.
WORKSHEET_1_ID=123456789
WORKSHEET_2_ID=987654321


# --- Scheduler ------------------------------------------------------------
TIMEZONE=Asia/Tashkent
SCHEDULE_HOUR=12
SCHEDULE_MINUTE=0
